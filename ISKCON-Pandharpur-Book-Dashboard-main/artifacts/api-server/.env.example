# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Admin SDK (for token verification)
# Leave empty for development mock mode - tokens will be accepted without verification
# For production, get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PostgreSQL Database Connection (Supabase)
# Will be configured after backend implementation is complete
# DATABASE_URL=postgresql://user:password@host:5432/database
